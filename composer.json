{
    "name": "active-campaign/php-sdk",
    "description": "PHP SDK for the ActiveCampaign API v3",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "ActiveCampaign\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ActiveCampaign\\Sdk\\Tests\\": "tests/"
        }
    }
}
